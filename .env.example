# ---- Local (docker compose / uvicorn) ----
INTERNAL_TOKEN=dev-token
KB_LIMIT=0                     # e.g. 5000 for faster RAG startup locally

# ---- GCP (used by infra/deploy.sh and Vertex AI calls) ----
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Local Vertex auth: `gcloud auth application-default login` (no API keys in code)

# ---- Escalation gate thresholds (send calibrated values to app owner) ----
GATE_MIN_CONFIDENCE=0.55
GATE_MIN_RETRIEVAL=0.45
GATE_NO_PRECEDENT=0.20
GATE_MIN_GROUNDEDNESS=0.35
